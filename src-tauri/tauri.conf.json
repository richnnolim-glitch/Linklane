{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linklane",
  "version": "0.1.0",
  "identifier": "app.linklane.desktop",
  "build": {
    "beforeDevCommand": "npm run lan:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run lan:build",
    "frontendDist": "../dist-lan"
  },
  "app": {
    "windows": [
      {
        "title": "Linklane",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Share files directly over your local Wi-Fi"
  }
}
